# Supabase project credentials
# Supabase dashboard → Project Settings → API
#
# VITE_SUPABASE_URL  = your project URL, e.g. https://abcdefgh.supabase.co
# VITE_SUPABASE_ANON_KEY = the "anon public" key (safe for client-side use)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional client URL for the production billing API (defaults to the OSS site).
# This is public configuration, not a secret.
VITE_OSS_API_BASE_URL=https://outlawshopsystems.netlify.app

# Server-only Netlify Function variables. Never prefix these with VITE_.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
# OSS_PUBLIC_URL=https://outlawshopsystems.netlify.app
# STRIPE_PRICE_SOLO=price_...
# STRIPE_PRICE_SHOP=price_...
# STRIPE_PRICE_DEALER=price_...
